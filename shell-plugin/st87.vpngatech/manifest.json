{
  "schemaVersion": 1,
  "id": "st87.vpngatech",
  "name": "Georgia Tech VPN",
  "version": "0.1.0",
  "author": "Steve Travis",
  "description": "Log in to the Georgia Tech GlobalProtect VPN (vpn.gatech.edu) from the bar",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "Georgia Tech VPN",
    "description": "GlobalProtect login with Duo, connection status, and disconnect",
    "category": "Network",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "refreshIntervalSec": 5
    },
    "schema": [
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Status refresh interval (seconds)",
        "min": 2,
        "max": 300,
        "step": 1,
        "defaultValue": 5
      }
    ]
  }
}
